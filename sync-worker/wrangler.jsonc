// غرفة المحادثة على Cloudflare Workers + Durable Object
// التسليم فوري وبترتيب مضمون (بدون تأخير اتساق KV) — كل غرفة كائن DO مستقل
{
  "name": "ain-chat",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
